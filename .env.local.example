# ─── KORA Foundation Light — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (LIVE environment) ───────────────────────────────────────────────
# Required for environment === "live" in ScoringResultProvider.
# Obtain from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key — server-side ONLY, never expose to browser.
# Required for admin operations and audit log writes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── KORA Application ──────────────────────────────────────────────────────────
# Current environment mode: "demo" | "live" | "future"
# Controls ScoringResultProvider routing, Sentry config, and environment banner.
# "demo"  — synthetic data only, no DB required (default for local dev).
# "live"  — real company/worker sessions backed by Supabase.
# "future"— roadmap / static mockup mode.
NEXT_PUBLIC_KORA_ENV=demo

# ── Site URL ──────────────────────────────────────────────────────────────────
# Public base URL — used by admin diagnostics and share-link generation.
# Local dev: http://localhost:3000 (Next.js may use :3001 if 3000 is occupied).
# Production: set to the Vercel deployment URL before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
# PDF export for Decision Pack reports (lib/decision-pack/pdf-strategy.ts).
# Disabled by default — set to "true" only after configuring server-side
# PDF generation (Puppeteer or equivalent). Leave "false" for local dev.
NEXT_PUBLIC_KORA_PDF_ENABLED=false

# ── Gate status flags (informational, not enforced at runtime) ────────────────
# Gate 2: CTO Architecture Review — required before production SQL
# Gate 3: Legal/Privacy — required before live company data
# Gate 5: Tax/Fiscal Advisor — required before live fiscal outputs
KORA_GATE_2_STATUS=open
KORA_GATE_3_STATUS=open
KORA_GATE_5_STATUS=open

# ── Sentry (B170) ─────────────────────────────────────────────────────────────
# DSN reale: impostare su Vercel Environment Variables — mai committare nel repo.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Required only for source map uploads. Leave empty in local dev.
SENTRY_AUTH_TOKEN=

# ── Audit Log ─────────────────────────────────────────────────────────────────
# Salt used for one-way hashing of IP and User-Agent in audit_log.
# MUST be set in production — fallback 'kora-audit-salt' is for local dev only.
AUDIT_HASH_SALT=cambia-questo-valore-in-produzione

# ── E2E Authenticated Tests (GOLDEN-02) ─────────────────────────────────────────
# Optional — only required to run tests/e2e/authenticated-smoke.spec.ts.
# These are NOT read by the app itself, only by the Playwright test runner
# (tests/e2e/helpers/env.ts). If unset, authenticated E2E tests skip cleanly.
# NEVER commit real values. See docs/testing-e2e-auth.md for full setup.
#
# Base URL under test. Defaults to http://localhost:3000 if unset.
# If this looks like a production URL, tests refuse to run unless
# E2E_ALLOW_PRODUCTION=true is also set.
E2E_BASE_URL=http://localhost:3000
E2E_ALLOW_PRODUCTION=false

# Test-only KORA_ADMIN account (non-production).
E2E_KORA_ADMIN_EMAIL=
E2E_KORA_ADMIN_PASSWORD=

# Test-only COMPANY_ADMIN accounts — two distinct tenants, for tenant
# isolation checks. tenant codes are optional/informational.
E2E_COMPANY_A_EMAIL=
E2E_COMPANY_A_PASSWORD=
E2E_COMPANY_A_TENANT_CODE=
E2E_COMPANY_B_EMAIL=
E2E_COMPANY_B_PASSWORD=
E2E_COMPANY_B_TENANT_CODE=

# ── RLS-03 Two-Tenant Negative DB Test ─────────────────────────────────────────
# Optional — only required to run tests/integration/rls-two-tenant-negative.test.ts.
# This test connects directly to Postgres (via `pg`), not through
# PostgREST/@supabase/supabase-js — it never requires exposing analytics/
# personal/commons/gov/audit/network via any project's Data API. It is
# LOCAL-ONLY by design: the test's own always-on guard hard-blocks any
# RLS03_PG_URL that isn't a loopback host (127.0.0.1/localhost/::1) or that
# matches a known staging/production project ref, even if RLS03_ALLOW_RUN is
# not set. Never put real values in this file or in
# .env.local/.env.staging.local — put them only in a gitignored
# .env.rls03.local. See docs/RLS_03_THROWAWAY_SUPABASE_CHECKLIST.md before
# setting either of these. If unset, the RLS-03 integration test skips
# cleanly (see its always-on guard, which still checks RLS03_PG_URL if only
# that one is set).
#
# DEPRECATED (superseded by RLS03_PG_URL below — no longer read by the
# current test; kept here only as a historical note for anyone who set them
# previously): RLS03_SUPABASE_URL, RLS03_SUPABASE_ANON_KEY,
# RLS03_SUPABASE_SERVICE_ROLE_KEY, RLS03_TENANT_A_EMAIL,
# RLS03_TENANT_A_PASSWORD, RLS03_TENANT_B_EMAIL, RLS03_TENANT_B_PASSWORD.
# Supabase Auth sign-in is not needed under the direct-DB approach — tenant
# claims are simulated as a transaction-local Postgres GUC instead.
#
# Confirm the real local connection string via `supabase status` rather than
# assuming the default below is correct for your machine.
# Example only: postgresql://postgres:postgres@127.0.0.1:54322/postgres
RLS03_PG_URL=
# Explicit second gate, required in addition to RLS03_PG_URL above —
# URL presence alone is never sufficient to run this test.
RLS03_ALLOW_RUN=false

# ── KORA Link (frozen pilot skeleton) ──────────────────────────────────────────
# Optional — KORA Link is a gated, default-off pilot skeleton (see
# docs/KORA_LINK_STATUS.md / docs/KORA_LINK_ADR.md). All three flags below
# default to false and are read via an EXACT 'true' string match (lib/kora-link/config.ts)
# — no truthy coercion. Leave all of these unset/false for normal local dev.
#
# Top-level route visibility for app/link/[token]/. When false, the public
# route is fully inert regardless of the other two flags below.
KORA_LINK_ENABLED=false
# Whether the public route performs a real DB-backed token lookup vs. showing
# a safe skeleton page. Requires the (currently unapplied) 034/036 migrations.
KORA_LINK_DB_LOOKUP_ENABLED=false
# Whether a signed-in worker can actually activate a scanned token. Requires
# KORA_LINK_DB_LOOKUP_ENABLED=true and the 036 RPC functions deployed.
KORA_LINK_ACTIVATION_ENABLED=false

# HMAC-SHA256 signing secret for token digests (lib/kora-link/token.ts).
# Must be at least 64 hex chars (256 bits) if set. Never commit a real value;
# never reuse the same secret between staging and production.
KORA_LINK_TOKEN_SECRET=

# Base URL used to construct the NFC chip's destination URL
# (`${KORA_LINK_PUBLIC_BASE_URL}/link/<token>`). http allowed for local dev;
# https required in production. Only read if KORA_LINK_ENABLED=true.
KORA_LINK_PUBLIC_BASE_URL=http://localhost:3000

# Rate-limit backend for the public lookup route: 'memory' (local dev
# default, single-instance only) or 'upstash' (required in production —
# also needs UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN, not KORA
# Link-specific, standard Upstash vars).
KORA_LINK_RATE_LIMIT_PROVIDER=memory
