# ─── KORA Foundation Light — Environment Variables ────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (LIVE environment) ───────────────────────────────────────────────
# Required for environment === "live" in ScoringResultProvider.
# Obtain from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role key — server-side ONLY, never expose to browser.
# Required for admin operations and audit log writes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── KORA Application ──────────────────────────────────────────────────────────
# Current environment mode: "demo" | "live" | "future"
# Controls ScoringResultProvider routing, Sentry config, and environment banner.
# "demo"  — synthetic data only, no DB required (default for local dev).
# "live"  — real company/worker sessions backed by Supabase.
# "future"— roadmap / static mockup mode.
NEXT_PUBLIC_KORA_ENV=demo

# ── Site URL ──────────────────────────────────────────────────────────────────
# Public base URL — used by admin diagnostics and share-link generation.
# Local dev: http://localhost:3000 (Next.js may use :3001 if 3000 is occupied).
# Production: set to the Vercel deployment URL before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
# PDF export for Decision Pack reports (lib/decision-pack/pdf-strategy.ts).
# Disabled by default — set to "true" only after configuring server-side
# PDF generation (Puppeteer or equivalent). Leave "false" for local dev.
NEXT_PUBLIC_KORA_PDF_ENABLED=false

# ── Gate status flags (informational, not enforced at runtime) ────────────────
# Gate 2: CTO Architecture Review — required before production SQL
# Gate 3: Legal/Privacy — required before live company data
# Gate 5: Tax/Fiscal Advisor — required before live fiscal outputs
KORA_GATE_2_STATUS=open
KORA_GATE_3_STATUS=open
KORA_GATE_5_STATUS=open

# ── Sentry (B170) ─────────────────────────────────────────────────────────────
# DSN reale: impostare su Vercel Environment Variables — mai committare nel repo.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Required only for source map uploads. Leave empty in local dev.
SENTRY_AUTH_TOKEN=

# ── Audit Log ─────────────────────────────────────────────────────────────────
# Salt used for one-way hashing of IP and User-Agent in audit_log.
# MUST be set in production — fallback 'kora-audit-salt' is for local dev only.
AUDIT_HASH_SALT=cambia-questo-valore-in-produzione
